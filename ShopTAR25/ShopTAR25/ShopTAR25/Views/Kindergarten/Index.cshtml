@model IEnumerable<ShopTAR25.Models.Kindergarten.KindergartenIndexViewModel>

@{
    ViewData["Title"] = "Kindergartens";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold mb-0">
        <i class="bi bi-flower1 text-primary me-2"></i>Kindergartens
    </h1>
    <a asp-action="Create" asp-controller="Kindergarten" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Create
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" class="ps-3">#</th>
                        <th scope="col">Group Name</th>
                        <th scope="col">Kindergarten Name</th>
                        <th scope="col">Teacher</th>
                        <th scope="col">Children Count</th>
                        <th scope="col">Created At</th>
                        <th scope="col">Updated At</th>
                        <th scope="col" class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 text-muted">@i</td>
                            <td class="fw-semibold">
                                <i class="bi bi-people text-secondary me-2"></i>@item.GroupName
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.KindergartenName</span>
                            </td>
                            <td>@item.TeacherName</td>
                            <td>
                                <span class="badge rounded-pill bg-info-subtle text-info-emphasis">
                                    <i class="bi bi-emoji-smile-fill me-1"></i>@(item.ChildrenCount?.ToString() ?? "—")
                                </span>
                            </td>
                            <td>
                                <i class="bi bi-calendar3 text-muted me-1"></i>
                                @(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd MMM yyyy, HH:mm") : "—")
                            </td>
                            <td>
                                <i class="bi bi-calendar-check text-muted me-1"></i>
                                @(item.UpdatedAt.HasValue ? item.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm") : "—")
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-outline-warning">
                                        <i class="bi bi-pencil"></i> Update
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted mt-5">
        <i class="bi bi-inboxes display-4"></i>
        <p class="mt-2">No kindergartens found. Click "Create" to add one.</p>
    </div>
}
