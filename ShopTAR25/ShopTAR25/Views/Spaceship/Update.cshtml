@model ShopTAR25.Models.Spaceship.SpaceshipUpdateViewModel

<h1>Update</h1>

<div>
    <h4>Spaceship</h4>
    <hr />
    
    <form method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <input asp-for="CreatedAt" type="hidden" />
        <input asp-for="ModifiedAt" type="hidden" />

        <div class="form-group row mb-3">
            <label asp-for="Name" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Classification" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Classification" class="form-control" />
                <span asp-validation-for="Classification" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-3">
            <label asp-for="Builddate" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Builddate" class="form-control" type="date" />
                <span asp-validation-for="Builddate" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group row mb-3">
            <label asp-for="Crew" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Crew" class="form-control" type="number" />
                <span asp-validation-for="Crew" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group row mb-3">
            <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="EnginePower" class="form-control" type="number" />
                <span asp-validation-for="EnginePower" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group row mt-4">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" asp-controller="spaceship" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </form>
</div>
