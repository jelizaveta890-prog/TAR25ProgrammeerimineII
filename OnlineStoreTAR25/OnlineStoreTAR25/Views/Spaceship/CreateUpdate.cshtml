@model ShopTARpe25.Models.Spaceship.SpaceshipCreateUpdateViewModel

@{
    var isUpdate = Model.Id.HasValue;
}

<div class="page-header">
    <h2>@(isUpdate ? "Update spaceship" : "New spaceship")</h2>
</div>

<form method="post" enctype="multipart/form-data" class="card-soft">
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Classification" class="form-label"></label>
            <input asp-for="Classification" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="BuiltDate" class="form-label"></label>
            <input asp-for="BuiltDate" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Crew" class="form-label"></label>
            <input asp-for="Crew" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="EnginePower" class="form-label"></label>
            <input asp-for="EnginePower" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Files" class="form-label"></label>
            <input asp-for="Files" class="form-control" type="file" multiple />
        </div>
    </div>

    <div class="gallery">
        @foreach (var image in Model.Image)
        {
            <div>
                <partial name="_Images" model="image" />
                <input asp-action="RemoveImage" asp-controller="Spaceship" asp-route-imageId="@image.ImageId"
                       type="submit" class="btn btn-sm btn-outline-danger w-100 mt-2" value="Remove" />
            </div>
        }
    </div>

    <hr class="my-4" />

    <div class="d-flex gap-2">
        <input asp-action="@(isUpdate ? "Update" : "Create")" asp-controller="Spaceship" type="submit"
               class="btn btn-primary" value="@(isUpdate ? "Save changes" : "Create")" />
        <a asp-action="Index" asp-controller="Spaceship" class="btn btn-outline-secondary">Back to list</a>
    </div>
</form>