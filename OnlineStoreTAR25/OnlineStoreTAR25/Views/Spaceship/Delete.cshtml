@model ShopTARpe25.Models.Spaceship.SpaceshipDeleteViewModel

<div class="page-header">
    <h2>Delete spaceship</h2>
</div>

<div class="card-soft">
    <div class="alert alert-danger">Are you sure you want to delete <strong>@Model.Name</strong>? This cannot be undone.</div>

    <dl class="row info-list mb-0">
        <dt class="col-sm-3">Classification</dt>
        <dd class="col-sm-9">@Model.Classification</dd>
        <dt class="col-sm-3">Built date</dt>
        <dd class="col-sm-9">@Model.BuiltDate?.ToString("dd.MM.yyyy HH:mm")</dd>
        <dt class="col-sm-3">Crew</dt>
        <dd class="col-sm-9">@Model.Crew</dd>
        <dt class="col-sm-3">Engine power</dt>
        <dd class="col-sm-9">@Model.EnginePower</dd>
    </dl>

    <div class="gallery">
        @foreach (var image in Model.Images)
        {
            <partial name="_Images" model="image" />
        }
    </div>

    <form asp-action="DeleteConfirmation" class="mt-4 d-flex gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>