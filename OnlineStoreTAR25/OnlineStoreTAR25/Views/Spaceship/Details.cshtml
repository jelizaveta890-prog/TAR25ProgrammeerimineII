@model ShopTARpe25.Models.Spaceship.SpaceshipDetailsViewModel

<div class="page-header">
    <h2>@Model.Name</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back to list</a>
</div>

<div class="card-soft">
    <dl class="row info-list mb-0">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9 text-muted small">@Model.Id</dd>
        <dt class="col-sm-3">Classification</dt>
        <dd class="col-sm-9">@Model.Classification</dd>
        <dt class="col-sm-3">Built date</dt>
        <dd class="col-sm-9">@Model.BuiltDate?.ToString("dd.MM.yyyy HH:mm")</dd>
        <dt class="col-sm-3">Crew</dt>
        <dd class="col-sm-9">@Model.Crew</dd>
        <dt class="col-sm-3">Engine power</dt>
        <dd class="col-sm-9">@Model.EnginePower</dd>
        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@Model.CreatedAt?.ToString("dd.MM.yyyy HH:mm")</dd>
        <dt class="col-sm-3">Modified</dt>
        <dd class="col-sm-9">@Model.ModifiedAt?.ToString("dd.MM.yyyy HH:mm")</dd>
    </dl>

    <div class="gallery">
        @foreach (var image in Model.Images)
        {
            <partial name="_Images" model="image" />
        }
    </div>
</div>