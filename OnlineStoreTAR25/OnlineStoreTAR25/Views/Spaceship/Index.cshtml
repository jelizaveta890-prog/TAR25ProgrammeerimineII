@model IEnumerable<ShopTARpe25.Models.Spaceship.SpaceshipIndexViewModel>

@* Pealkiri ja "Create" nupp *@
<div class="page-header">
    <h2>Spaceships</h2>
    <a asp-action="Create" class="btn btn-primary">+ New spaceship</a>
</div>

@* Loendi kuvamine kaardi sees *@
<div class="card-soft p-0 overflow-hidden">
    <table class="table table-modern">
        <thead>
            <tr>
                <th class="ps-4">Nr</th>
                <th>Name</th>
                <th>Type</th>
                <th>Built Date</th>
                <th>Crew</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @{
                int rownumber = 1; @* loendus algab ühest *@
            }
            @foreach (var ship in Model)
            {
                <tr>
                    <td class="ps-4 text-muted">@rownumber</td>
                    <td class="fw-semibold">@ship.Name</td>
                    <td><span class="badge rounded-pill text-bg-light border">@ship.Classification</span></td>
                    <td>@ship.BuiltDate?.ToString("dd.MM.yyyy")</td>
                    <td>@ship.Crew</td>
                    <td class="text-end pe-4">
                        @* Nupud: details, update, delete *@
                        <a asp-action="Details" asp-route-id="@ship.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Update" asp-route-id="@ship.Id" class="btn btn-sm btn-outline-primary">Update</a>
                        <a asp-action="Delete" asp-route-id="@ship.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
                rownumber++;
                @* iga uus rida on üks number suurem *@
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="text-center text-muted py-5 mb-0">No spaceships yet. Create the first one!</p>
    }
</div>