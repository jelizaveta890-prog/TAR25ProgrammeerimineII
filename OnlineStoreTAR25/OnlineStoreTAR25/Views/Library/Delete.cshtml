@model ShopTARpe25.Models.Library.LibraryDeleteViewModel

<h1>Delete Book</h1>
<h3 class="text-danger">Are you sure you want to delete this?</h3>

<div class="card p-4 mt-3 col-md-6 shadow-sm border-danger">
    <div class="row mb-2">
        <div class="col-sm-4 fw-bold">Book Title:</div>
        <div class="col-sm-8">@Model.Name</div>
    </div>
    <div class="row mb-2">
        <div class="col-sm-4 fw-bold">Author:</div>
        <div class="col-sm-8">@Model.Classification</div>
    </div>
    
    <hr />
    
    <form action="/Library/DeleteConfirmation/@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Delete Permanently</button>
        <a href="/Library" class="btn btn-secondary ms-2">Back to List</a>
    </form>
</div>
