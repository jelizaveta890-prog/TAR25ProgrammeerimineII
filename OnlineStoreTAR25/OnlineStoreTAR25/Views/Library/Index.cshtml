@model IEnumerable<ShopTARpe25.Models.Library.LibraryIndexViewModel>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="mb-3">
    <a href="/Library/Create" class="btn btn-primary">Create New Book</a>
</div>

<h2>Library Items</h2>

<form action="/Library" method="get" class="row g-3 mb-4 p-3 bg-light border rounded">
    <div class="col-md-4">
        <label class="form-label">Otsi pealkirja järgi</label>
        <input type="text" name="searchTitle" value="@ViewData["CurrentTitle"]" class="form-control" placeholder="Sisesta pealkiri..." />
    </div>
    <div class="col-md-3">
        <label class="form-label">Ilmumisaasta</label>
        <input type="number" name="searchYear" value="@ViewData["CurrentYear"]" class="form-control" placeholder="Nt. 2026" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Saadavuse staatus</label>
        <select name="filterStatus" class="form-select">
            <option value="">Kõik raamatud</option>
            <option value="Saadaval" selected="@(ViewData["CurrentStatus"]?.ToString() == "Saadaval")">Saadaval (Kohal)</option>
            <option value="Laenutatud" selected="@(ViewData["CurrentStatus"]?.ToString() == "Laenutatud")">Laenutatud (Väljas)</option>
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-secondary w-100">Filtreeri</button>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nr</th>
            <th>Name (Title)</th>
            <th>Classification (Author)</th>
            <th>Built Date (Year)</th>
            <th>Status (Crew)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            int rownumber = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@rownumber</td>
                <td>@item.Name</td>
                <td>@item.Classification</td>
                <td>@item.BuiltDate?.Year</td>
                <td>
                    @if (item.Crew == 1)
                    {
                        <span class="badge bg-success">Saadaval</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Laenutatud</span>
                    }
                </td>
                <td>
                    <a href="/Library/Details/@item.Id" class="btn btn-sm btn-warning">Details</a>
                    <a href="/Library/Update/@item.Id" class="btn btn-sm btn-primary">Update</a>
                    <a href="/Library/Delete/@item.Id" class="btn btn-sm btn-danger">Delete</a>

                    @if (item.Id != Guid.Empty)
                    {
                        if (item.Crew == 1)
                        {
                            <a href="/Library/LoanBook/@item.Id" class="btn btn-sm btn-success">Laenuta</a>
                        }
                        else
                        {
                            <form action="/Library/ReturnBook/@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-info">Tagasta</button>
                            </form>
                        }
                    }
                </td>
            </tr>
            rownumber++;
        }

        @if (!Model.Any())
        {
            if ((bool)(ViewData["DbEmpty"] ?? false))
            {
                <div class="alert alert-info">Andmebaas on veel tühi - lisa uus raamat!</div>
            }
            else
            {
                <div class="alert alert-warning">Otsingule ei leitud ühtegi raamatut.</div>
            }
        }
    </tbody>
</table>