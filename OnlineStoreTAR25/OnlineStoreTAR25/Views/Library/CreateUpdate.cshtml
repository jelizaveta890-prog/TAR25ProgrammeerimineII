@model ShopTARpe25.Models.Library.LibraryCreateUpdateViewModel

@if (Model.Id != Guid.Empty)
{
    <h1>Library Item Update</h1>
}
else
{
    <h1>Library Item Create</h1>
}

<form method="post">
    <div>
        Library Form
    </div>

    <div class="mb-3row">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control" />
        </div>
    </div>

    <div class="mb-3row">
        <label asp-for="Classification" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Classification" class="form-control" />
        </div>
    </div>

    <div class="mb-3row">
        <label asp-for="BuiltDate" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="BuiltDate" class="form-control" type="date" />
        </div>
    </div>

    <div class="mb-3row">
        <label asp-for="Crew" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Crew" class="form-control" />
        </div>
    </div>

    <div class="mb-3row">
        <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="EnginePower" class="form-control" />
        </div>
    </div>

    <hr />

    @if (Model.Id != Guid.Empty)
    {
        <input asp-action="update" asp-controller="library" type="submit" class="btn btn-primary" value="Update" />
    }
    else
    {
        <input asp-action="create" asp-controller="library" type="submit" class="btn btn-primary" value="Create" />
    }

    <a asp-action="Index" asp-controller="library" class="btn btn-secondary">Back to List</a>
</form>
