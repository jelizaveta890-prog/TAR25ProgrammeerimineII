@model ShopTARpe25.Models.Library.LibraryCreateUpdateViewModel

@if (Model.Id != Guid.Empty)
{
    <h1>Library Item Update</h1>
}
else
{
    <h1>Library Item Create</h1>
}

<div class="row mt-4">
    <div class="col-md-6">
        <form method="post">
            <!-- Peidetud väli ID jaoks, et muutmine (Update) teaks, mis raamatuga on tegu -->
            <input type="hidden" asp-for="Id" />

            <!-- 1. Raamatu Pealkiri -->
            <div class="mb-3 row">
                <label asp-for="Name" class="col-sm-3 col-form-label fw-bold">Book Title</label>
                <div class="col-sm-9">
                    <input asp-for="Name" class="form-control" placeholder="Sisesta pealkiri..." required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <!-- 2. Raamatu Autor -->
            <div class="mb-3 row">
                <label asp-for="Classification" class="col-sm-3 col-form-label fw-bold">Author</label>
                <div class="col-sm-9">
                    <input asp-for="Classification" class="form-control" placeholder="Sisesta autor..." required />
                    <span asp-validation-for="Classification" class="text-danger"></span>
                </div>
            </div>

            <!-- 3. Ilmumiskuupäev / aasta -->
            <div class="mb-3 row">
                <label asp-for="BuiltDate" class="col-sm-3 col-form-label fw-bold">Published Date</label>
                <div class="col-sm-9">
                    <input asp-for="BuiltDate" class="form-control" type="date" required />
                    <span asp-validation-for="BuiltDate" class="text-danger"></span>
                </div>
            </div>

            <!-- Peidame laeva vanad väljad taustale ära, et kasutaja neid ei näeks -->
            <input type="hidden" asp-for="Crew" value="1" />
            <input type="hidden" asp-for="EnginePower" value="0" />

            <hr />

            <div class="mb-3">
                @if (Model.Id != Guid.Empty)
                {
                    <input asp-action="Update" asp-controller="Library" type="submit" class="btn btn-primary" value="Update Book" />
                }
                else
                {
                    <input asp-action="Create" asp-controller="Library" type="submit" class="btn btn-primary" value="Create Book" />
                }
                <a href="/Library" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
