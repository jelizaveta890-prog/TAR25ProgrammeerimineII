@model ShopTARpe25.Models.Library.LibraryCreateUpdateViewModel

@{
    bool isUpdate = Model.Id.HasValue && Model.Id.Value != Guid.Empty;
}

<h1>@(isUpdate ? "Library Item Update" : "Library Item Create")</h1>

<div class="row mt-4">
    <div class="col-md-6">
        <form method="post"
              asp-controller="Library"
              asp-action="@(isUpdate ? "Update" : "Create")"
              asp-route-id="@(isUpdate? Model.Id: null)">

            <input type="hidden" name="Id" value="@(isUpdate? Model.Id.ToString() : "")" />

            <div class="mb-3 row">
                <label class="col-sm-3 col-form-label fw-bold">Book Title</label>
                <div class="col-sm-9">
                    <input type="text" name="Name" value="@Model.Name" class="form-control" placeholder="Sisesta pealkiri..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-3 col-form-label fw-bold">Author</label>
                <div class="col-sm-9">
                    <input type="text" name="Classification" value="@Model.Classification" class="form-control" placeholder="Sisesta autor..." />
                    <span asp-validation-for="Classification" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-3 col-form-label fw-bold">Published Date</label>
                <div class="col-sm-9">
                    <input type="date" name="BuiltDate" value="@(Model.BuiltDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                    <span asp-validation-for="BuiltDate" class="text-danger"></span>
                </div>
            </div>

            <hr />

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">@(isUpdate ? "Update Book" : "Create Book")</button>
                <a href="/Library" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>